# Copy this file to .env in the same folder. Never commit .env.

# Sub-account Private Integration token. Starts with pit-. Paste it right after the = with no spaces or quotes.
GHL_TOKEN=

# The id in app.gohighlevel.com/v2/location/<id>/...
GHL_LOCATION_ID=

# Optional settings below. Leave empty unless you need them.

# Looked up automatically if empty.
GHL_USER_ID=
# Only if you have several proposal templates named Proposal.
GHL_PROPOSAL_TEMPLATE_ID=
# document (default) or estimate.
GHL_PROPOSAL_FORMAT=
# Failure alerts: a Slack-compatible incoming webhook URL.
ALERT_WEBHOOK_URL=
# Failure alerts by email (needs RESEND_API_KEY).
ALERT_EMAIL=
RESEND_API_KEY=
# Only for white-label domains, e.g. https://app.youragency.com
GHL_APP_URL=
