# Copy to .env in this folder (never commit it).
GHL_TOKEN=            # sub-account Private Integration token, starts with pit-
GHL_LOCATION_ID=      # the id in app.gohighlevel.com/v2/location/<id>/...
# Optional
GHL_USER_ID=          # looked up automatically if unset
ALERT_WEBHOOK_URL=    # Slack-compatible incoming webhook for failure alerts
ALERT_EMAIL=          # alerts by email via Resend (needs RESEND_API_KEY)
RESEND_API_KEY=
GHL_APP_URL=          # only for white-label domains
